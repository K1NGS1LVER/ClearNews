# copy to .env and fill in
DATABASE_URL=postgresql+psycopg://localhost:5432/clearnews
REDIS_URL=redis://localhost:6379/0
# get a free key at https://console.groq.com — powers chat, summaries, suggested questions
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# SUGGEST_MODEL=llama-3.1-8b-instant   # separate small model for suggested
                                        # follow-ups - Groq free tier is
                                        # 8000 tokens/min *per model*, so this
                                        # keeps it from starving chat's budget
# CHAT_RECURSION_LIMIT=12              # max agent tool-call rounds per reply

# live-web agent tool - optional. Defaults to a self-hosted SearXNG instance
# (see docker-compose.yml); leave unset outside docker-compose and the tool
# just returns no results. Set WEB_SEARCH_PROVIDER=tavily or brave plus the
# matching key below to use a hosted provider instead (both are quota-limited
# on their free tiers).
# WEB_SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://localhost:8080
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# production only - leave unset for local dev
# ENV=production                              # marks the session cookie Secure
# FRONTEND_ORIGIN=https://app.example.com      # comma-separated; enables CORS for a
                                               # frontend hosted on a different origin
                                               # than the API (not needed behind the
                                               # docker-compose nginx proxy)
