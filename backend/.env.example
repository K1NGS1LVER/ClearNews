# copy to .env and fill in
DATABASE_URL=postgresql+psycopg://localhost:5432/clearnews
# get a free key at https://console.groq.com — powers chat, summaries, suggested questions
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# production only - leave unset for local dev
# ENV=production                              # marks the session cookie Secure
# FRONTEND_ORIGIN=https://app.example.com      # comma-separated; enables CORS for a
                                               # frontend hosted on a different origin
                                               # than the API (not needed behind the
                                               # docker-compose nginx proxy)
